% Shared cover fields and renderer dispatch.
\newtoks\fenlei          % 中图分类号
\newtoks\DWdaihao        % 单位代号
\newtoks\miji            % 密级
\newtoks\StuNum          % 学号
\newtoks\CThesisType     % 论文类型 中
\newtoks\EThesisType     % 论文类型 英
\newtoks\Ctitle          % 中文标题
\newtoks\Etitle          % 英文标题
\newtoks\Cauthor         % 作者中文名
\newtoks\Cmajor          % 专业
\newtoks\Csuperver       % 导师
\newtoks\Ccosuperver     % 合作导师
\newtoks\Cdate           % 中文日期
\newtoks\Dpart           % 学院
\newtoks\Dform           % 培养方式
\newtoks\Grade           % 年级
\newtoks\ThesisHeader    % 正文页眉
\newtoks\EThesisHeader   % 英文页眉

\RequirePackage{makecell}
\RequirePackage{colortbl}

% Compatibility override: existing documents may keep using
% \DegreeType{<custom formatted label>}. New documents should use degree=.
\newif\ifSDU@degree@override
\newtoks\SDU@degree@override@text
\newcommand{\DegreeType}[1]{%
  \SDU@degree@overridetrue
  \SDU@degree@override@text={#1}%
}

\newcommand{\SDU@current@degree@line}{%
  {\heiti\zihao{1}%
    \ifSDU@degree@override
      \the\SDU@degree@override@text
    \else
      \ifSDU@degree@professional
        \textcolor{SDUred}{（专业学位）}%
      \else
        （学术学位）%
      \fi
    \fi
  }%
}

\newcommand{\SDU@legacy@degree@line}{%
  \ifSDU@degree@override
    {\heiti\zihao{1}\the\SDU@degree@override@text\par\vspace{2mm}}%
  \else
    \ifSDU@degree@professional
      {\heiti\zihao{1}\textcolor{SDUred}{（专业学位）}\par\vspace{2mm}}%
    \fi
  \fi
}

\input{sduthesis-cover-2024.def}
\input{sduthesis-cover-legacy.def}

\newcommand{\maketitlepage}{%
  \ifSDU@cover@legacy
    \SDU@make@legacy@cover
  \else
    \SDU@make@current@cover
  \fi
}
